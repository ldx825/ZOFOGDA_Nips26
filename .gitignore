# Python caches and local tooling
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store

# Local experiment/debug caches
debugpy*/
wandb/

# Files exceeding GitHub's 100 MB per-file limit.
# These are downloadable/extracted CIFAR datasets, not source code.
/ZOFOGDA_GAN/data/cifar-10-python.tar.gz
/ZOFOGDA_GAN/data/cifar-100-python.tar.gz
/ZOFOGDA_GAN/data/cifar-100-python/train

# Rebuttal runtime artifacts (generated; source tables/configs remain tracked)
/rebuttal/results/
/rebuttal/logs/
/rebuttal/plots/

# Original-code AUC rebuttal runtime artifacts.
# Keep the reproducible manager, manifest, queues, registry, and workbook;
# exclude files that are still being written by background workers.
/rebuttal_auc_original/__pycache__/
/rebuttal_auc_original/logs/
/rebuttal_auc_original/runs/
/rebuttal_auc_original/restarted_pre_exclusive/
/rebuttal_auc_original/historical_unverified/
/rebuttal_auc_original/plots/
/rebuttal_auc_original/*.tmp.xlsx
# Locally frozen/stale workbook copies; the canonical tracked workbook is
# rebuttal_auc_original/AUC_rebuttal_results.xlsx.
/rebuttal_auc_original/*_FINAL.xlsx
~$*.xlsx

# Common local process/editor artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.idea/
.vscode/
*.log
*.pid
*.swp
*~
